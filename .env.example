USE_MOCK_CONGESTION=false
SEOUL_API_KEY=
SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_ZONES_FILE=data/seoul_zones.geojson
CONGESTION_FALLBACK=empty
CONGESTION_TTL_SECONDS=60
API_TIMEOUT_SECONDS=10
MAX_DETOUR_RATIO=1.30
WALKING_SPEED_KMH=4.5
HIGH_CONGESTION_THRESHOLD=0.7
GRAPH_MIN_RADIUS_M=1500
GRAPH_BUFFER_M=1000
GRAPH_MAX_RADIUS_M=10000
GRAPH_CACHE_SIZE=4
MAX_SNAP_DISTANCE_M=500
OSM_TIMEOUT_SECONDS=90
# Optional OSMnx GraphML previously downloaded from OSM; empty = live OSM.
GRAPHML_PATH=

# Population JSON (default) or integrated city XML
SEOUL_API_SERVICE=citydata_ppltn
# Empty: query route-nearby official zones (fills nearest spots up to 5); optional comma-separated codes
SEOUL_AREA_CODES=
SEOUL_MAX_AGE_MINUTES=60
# Optional Kakao Local REST API key: detailed business and address search
KAKAO_REST_API_KEY=
